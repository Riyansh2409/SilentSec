# Example only. The launcher does not automatically load this file.
SILENTSEC_PLATFORM_ENVIRONMENT=production
SILENTSEC_PLATFORM_AUTH_MODE=oidc
SILENTSEC_PLATFORM_DATABASE_URL=postgresql+psycopg://APP_USER:REPLACE_PASSWORD@DB_HOST/silentsec
SILENTSEC_PLATFORM_REDIS_URL=redis://REDIS_HOST:6379/0
SILENTSEC_PLATFORM_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SILENTSEC_PLATFORM_PUBLIC_URL=https://silentsec.example
SILENTSEC_PLATFORM_ALLOWED_ORIGINS=["https://silentsec.example"]
SILENTSEC_PLATFORM_OIDC_ISSUER=https://identity.example
SILENTSEC_PLATFORM_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
SILENTSEC_PLATFORM_OIDC_CLIENT_ID=REPLACE_CLIENT_ID
SILENTSEC_PLATFORM_OIDC_CLIENT_SECRET=REPLACE_CLIENT_SECRET
SILENTSEC_PLATFORM_OIDC_AUDIENCE=silentsec-api
SILENTSEC_PLATFORM_OIDC_MFA_ACR=[]
SILENTSEC_PLATFORM_AUTO_WORKER=false
# Set true only after separately deploying restricted, least-privilege workers.
SILENTSEC_PLATFORM_ISOLATED_WORKERS=false
# Development only: allow operator-registered local checkouts. Forbidden in production.
SILENTSEC_PLATFORM_WORKSTATION_ENABLED=false
