# Copy to .env and fill in locally. Never commit real values.
# silentsec loads this checkout's .env automatically (shell variables win).
# AI triage is optional; scanning and scoring work without any keys.

GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local AI with Ollama (no key; code stays on this machine).
# Setup: ollama pull qwen2.5-coder:7b   (about 5 GB; best on a GPU with 6 GB+)
# Only loopback hosts are allowed unless SILENTSEC_OLLAMA_ALLOW_REMOTE=1.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120

# Order in which AI providers are tried: a comma list of ollama, groq, gemini.
# Empty uses the default: ollama,groq,gemini (local first; cloud only with a key).
SILENTSEC_AI_PROVIDERS=

# Optional: replace the bundled offline Semgrep rules.
# Registry configs such as p/security-audit need network access.
SILENTSEC_SEMGREP_CONFIG=

# AI triage results are cached so repeated scans do not spend quota again.
# Default directory: ~/.cache/silentsec/triage. Set to "off" to disable.
SILENTSEC_TRIAGE_CACHE=
SILENTSEC_TRIAGE_CACHE_DIR=
