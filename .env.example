# Copy to .env and fill in locally. Never commit real values.
# AI triage is optional; scanning and scoring work without any keys.

GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: replace the bundled offline Semgrep rules.
# Registry configs such as p/security-audit need network access.
SILENTSEC_SEMGREP_CONFIG=

# AI triage results are cached so repeated scans do not spend quota again.
# Default directory: ~/.cache/silentsec/triage. Set to "off" to disable.
SILENTSEC_TRIAGE_CACHE=
SILENTSEC_TRIAGE_CACHE_DIR=
